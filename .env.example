# Base domain for routing.
# Production: must be a real domain name you control.
# Development: copy this file to .env.dev and set DOMAIN_NAME="hyac.localhost".
DOMAIN_NAME=""

# Email address for Let's Encrypt certificate registration
EMAIL_ADDRESS=""

# Timezone setting. If set to Asia/Shanghai, it will use a domestic mirror for acceleration.
TZ="Asia/Shanghai"

# MongoDB connection settings
MONGODB_USERNAME="hyac-root"
MONGODB_PASSWORD=""

# S3-compatible object storage settings
# RustFS is the default deployment target.
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_INTERNAL_ENDPOINT="rustfs:9000"
S3_EXTERNAL_ENDPOINT="oss.${DOMAIN_NAME}"
S3_SECURE_INTERNAL=false
S3_SECURE_EXTERNAL=true
S3_PUBLIC_BASE_URL="https://oss.${DOMAIN_NAME}"
S3_REGION="us-east-1"

# Secret key for JWT token signing and other cryptographic operations
SECRET_KEY=""

# Default admin user credentials
DEFAULT_ADMIN_USER="admin"
DEFAULT_ADMIN_PASSWORD=""

# only use for dev mode
DEV_MODE=false
# APP_CODE_PATH_ON_HOST="/absolute/path/to/hyac/app"  # development only
# Demo mode setting. If true, some features will be disabled. This used for web console
DEMO_MODE=false


# Image tag settings for server, web, and app services.
# Production requires APP_IMAGE_TAG to be an immutable release tag, never 'latest'.
# You can use a global release tag for all services, or specify each tag individually.

# Example for using a global tag:
GLOBAL_TAG=
SERVER_IMAGE_TAG=${GLOBAL_TAG}
WEB_IMAGE_TAG=${GLOBAL_TAG}
APP_IMAGE_TAG=${GLOBAL_TAG}
