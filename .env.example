# Base domain for routing.
# Production: must be a real domain name you control.
# Development: copy this file to .env.dev and set DOMAIN_NAME="hyac.localhost".
DOMAIN_NAME=""

# Email address for Let's Encrypt certificate registration
EMAIL_ADDRESS=""

# Production TLS uses a single *.DOMAIN_NAME certificate obtained with DNS-01.
# Choose a provider supported by Traefik's embedded lego client, for example namesilo.
ACME_DNS_PROVIDER=""
# Host path to a provider-specific environment file. Prefer *_FILE variables in it.
ACME_DNS_CREDENTIALS_FILE=""
# Host directory mounted read-only at /run/secrets/acme-dns in Traefik.
ACME_DNS_SECRETS_DIR="/etc/hyac/acme-dns"
# Use the Let's Encrypt staging URL and a separate storage file during first validation.
ACME_CA_SERVER="https://acme-v02.api.letsencrypt.org/directory"
ACME_STORAGE_FILE="/letsencrypt/acme.json"

# Timezone setting. If set to Asia/Shanghai, it will use a domestic mirror for acceleration.
TZ="Asia/Shanghai"

# MongoDB connection settings
MONGODB_USERNAME="hyac-root"
MONGODB_PASSWORD=""

# S3-compatible object storage settings
# RustFS is the default deployment target.
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_INTERNAL_ENDPOINT="rustfs:9000"
S3_EXTERNAL_ENDPOINT="oss.${DOMAIN_NAME}"
S3_SECURE_INTERNAL=false
S3_SECURE_EXTERNAL=true
S3_PUBLIC_BASE_URL="https://oss.${DOMAIN_NAME}"
S3_REGION="us-east-1"

# Secret key for JWT token signing and other cryptographic operations
SECRET_KEY=""

# Default admin user credentials
DEFAULT_ADMIN_USER="admin"
DEFAULT_ADMIN_PASSWORD=""

# only use for dev mode
DEV_MODE=false
# APP_CODE_PATH_ON_HOST="/absolute/path/to/hyac/app"  # development only
# Demo mode setting. If true, some features will be disabled. This used for web console
DEMO_MODE=false


# Image tag settings for server, web, app runtime, and the LSP sidecar.
# Production should set GLOBAL_TAG to one stable release tag such as v1.2.3.
# The LSP sidecar intentionally reuses the app image; no separate LSP image is published.

# Example for using a global tag:
GLOBAL_TAG=
SERVER_IMAGE_TAG=${GLOBAL_TAG}
WEB_IMAGE_TAG=${GLOBAL_TAG}
APP_IMAGE_TAG=${GLOBAL_TAG}
